# sdpb_header_version(<out> <header> <macro>...)
# Sets <out> to "X.Y.Z" from integer macros "#define <macro> X" in <header>,
# or to an empty string if <header> or some macro is missing.
function(sdpb_header_version out header)
  if(NOT EXISTS "${header}")
    set(${out} "" PARENT_SCOPE)
    return()
  endif()
  set(parts "")
  foreach(macro IN LISTS ARGN)
    file(STRINGS "${header}" line REGEX "^#[ \t]*define[ \t]+${macro}[ \t]+[0-9]+")
    if(NOT line MATCHES "define[ \t]+${macro}[ \t]+([0-9]+)")
      set(${out} "" PARENT_SCOPE)
      return()
    endif()
    list(APPEND parts ${CMAKE_MATCH_1})
  endforeach()
  list(JOIN parts "." version)
  set(${out} "${version}" PARENT_SCOPE)
endfunction()
